# ==============================================================================
# Maruti Stationery — Gmail Automation Environment Configuration
# ==============================================================================

# Server Port
PORT=5001

# Gmail SMTP Configuration
# NOTE: Use a Google Account App Password (16 characters), NOT your account login password.
# To generate one:
# 1. Go to Google Account > Security > 2-Step Verification (must be ON).
# 2. Scroll to bottom > App passwords.
# 3. Create app name "Maruti Stationery App" and copy the 16-character code.
GMAIL_USER=marutistationery.orders@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Sender Display Details
EMAIL_FROM_NAME=Maruti Stationery
EMAIL_FROM_ADDRESS=marutistationery.orders@gmail.com

# Store Support Information (included in email footers)
SUPPORT_EMAIL=support@marutistationery.com
SUPPORT_PHONE=+91 98765 43210
STORE_ADDRESS=Maruti Stationery, Surat, Gujarat - 395007
WEBSITE_URL=https://marutistationery.com

# Security & Retry
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1500

